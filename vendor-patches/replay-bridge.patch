--- a/tests/core/DuelBehaviors.test.ts
+++ b/tests/core/DuelBehaviors.test.ts
@@ -0,0 +1,46 @@
+import { ImprovedHardExecution } from "../../../../engine/improvedHardBehavior";
+import { Executor } from "../../src/core/execution/ExecutionManager";
+import { NationExecution } from "../../src/core/execution/NationExecution";
+import {
+  Cell,
+  Game,
+  Nation,
+  PlayerInfo,
+  PlayerType,
+} from "../../src/core/game/Game";
+import { GameID } from "../../src/core/Schemas";
+
+const gameID: GameID = "duel_game_id";
+
+function mkNation(i: number): Nation {
+  return new Nation(
+    new Cell(20 + i * 15, 20 + i * 15),
+    new PlayerInfo(`Nation${i}`, PlayerType.Nation, null, `nation_${i}`),
+  );
+}
+
+function duelExecutor(): Executor {
+  // nationExecutions only reads mg.nations() + gameID; a stub game keeps
+  // this test map-free and instant.
+  const mg = { nations: () => [mkNation(0), mkNation(1)] };
+  return new Executor(mg as unknown as Game, gameID, "client_1", []);
+}
+
+describe("Duel per-nation behavior assignment", () => {
+  test("mixed array assigns ImprovedHard to index 0, production to index 1", () => {
+    const execs = duelExecutor().nationExecutions([
+      "improved-hard",
+      "production",
+    ]);
+    expect(execs).toHaveLength(2);
+    expect(execs[0]).toBeInstanceOf(ImprovedHardExecution);
+    expect(execs[1]).toBeInstanceOf(NationExecution);
+  });
+
+  test("uniform string preserves the legacy all-one-logic path", () => {
+    const allIH = duelExecutor().nationExecutions("improved-hard");
+    expect(allIH.every((e) => e instanceof ImprovedHardExecution)).toBe(true);
+    const allProd = duelExecutor().nationExecutions();
+    expect(allProd.every((e) => e instanceof NationExecution)).toBe(true);
+  });
+});
--- /dev/null
+++ b/tests/core/ExternalBehaviors.test.ts
@@ -0,0 +1,56 @@
+import { ExternalExecution } from "../../../../engine/externalBehavior";
+import { Executor } from "../../src/core/execution/ExecutionManager";
+import { NationExecution } from "../../src/core/execution/NationExecution";
+import {
+  Cell,
+  Game,
+  Nation,
+  PlayerInfo,
+  PlayerType,
+} from "../../src/core/game/Game";
+import { GameID } from "../../src/core/Schemas";
+
+const gameID: GameID = "ext_game_id";
+
+function mkNation(i: number): Nation {
+  return new Nation(
+    new Cell(20 + i * 15, 20 + i * 15),
+    new PlayerInfo(`Nation${i}`, PlayerType.Nation, null, `nation_${i}`),
+  );
+}
+
+function extExecutor(): Executor {
+  // nationExecutions only reads mg.nations() + gameID; a stub game keeps
+  // this test map-free and instant.
+  const mg = { nations: () => [mkNation(0), mkNation(1)] };
+  return new Executor(mg as unknown as Game, gameID, "client_1", []);
+}
+
+describe("External per-nation assignment + order preload", () => {
+  test("external index gets ExternalExecution, production stays production", () => {
+    const execs = extExecutor().nationExecutions(["external", "production"]);
+    expect(execs).toHaveLength(2);
+    expect(execs[0]).toBeInstanceOf(ExternalExecution);
+    expect(execs[1]).toBeInstanceOf(NationExecution);
+  });
+
+  test("taped orders preload per nation index", () => {
+    const execs = extExecutor().nationExecutions(
+      ["external", "external"],
+      [
+        { tick: 10, nation: 1, targetID: "nation_0", troops: 500 },
+        { tick: 5, nation: 0, targetID: "nation_1", troops: 1000 },
+      ],
+    );
+    expect(execs[0]).toBeInstanceOf(ExternalExecution);
+    expect(execs[1]).toBeInstanceOf(ExternalExecution);
+    // Per-index slice: nation 0 sees only its own order.
+    expect((execs[0] as unknown as { queue: unknown[] }).queue).toHaveLength(1);
+    expect((execs[1] as unknown as { queue: unknown[] }).queue).toHaveLength(1);
+  });
+
+  test("no orders means an empty live queue", () => {
+    const execs = extExecutor().nationExecutions(["external", "production"]);
+    expect((execs[0] as unknown as { queue: unknown[] }).queue).toHaveLength(0);
+  });
+});
