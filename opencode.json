{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "crossref": {
      "type": "local",
      "command": ["npx", "-y", "@cyanheads/crossref-mcp-server"],
      "enabled": false
    },
    "openalex": {
      "type": "local",
      "command": ["npx", "-y", "openalex-research-mcp"],
      "enabled": false
    },
    "pubmed": {
      "type": "local",
      "command": ["npx", "-y", "@cyanheads/pubmed-mcp-server"],
      "enabled": false
    }
  },
  "agent": {
    "python-engineer": {
      "description": "Implements small, well-tested Python changes using TDD, uv, ruff, ty, and pytest.",
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5"
    },
    "scout": {
      "description": "Read-only agent for external docs, dependency research, and codebase reconnaissance.",
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5"
    },
    "explore": {
      "description": "Explores codebase structure, finds relevant files, and provides context for implementation tasks.",
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5"
    }
  },
  "command": {
    "check": {
      "description": "Run format, lint, type, and test checks",
      "template": "Run: `uv run ruff format --check`, `uv run ruff check`, `uv run ty check src/*`, and `uv run pytest`."
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": {
      "uv *": "allow",
      "git status": "allow",
      "git fetch *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git branch --show-current": "allow",
      "git branch -a": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push *": "allow",
      "git checkout *": "allow",
      "git worktree *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "gh auth status": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh pr create *": "allow",
      "gh issue *": "allow",
      "gh repo *": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "wget *": "deny"
    },
    "external_directory": {
      "/private/tmp/**": "allow",
      "/tmp/**": "allow"
    },
    "skill": "allow"
  },
  "share": "disabled"
}
